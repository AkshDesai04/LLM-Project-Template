# Copy to .env and fill in the values you need. .env is gitignored.
# Values shown after "=" are the defaults applied when the variable is unset.


# ============================================
# Runtime & Logging
# ============================================

# NORMAL  -> standard logging package: console handler + JSON file in /logs
# LAMBDA  -> print() to stdout only; no file handler (read-only FS, CloudWatch
#            already captures stdout)
LOGGING_MODE=NORMAL

# DEBUG | INFO | WARNING | ERROR | CRITICAL (a numeric level also works)
LOGGING_LEVEL=INFO


# ============================================
# Secret Resolution
# ============================================

# LOCAL   -> secrets are read from this .env via get_local_secret
# AWS_SM  -> secrets are read from AWS Secrets Manager via get_aws_secret
#
# Applies to credentials only (DATABASE_URL, provider keys, provider URLs).
# Mode switches, project ids and regions are always read from .env.
KEY_LOCATION=LOCAL

# Required when KEY_LOCATION=AWS_SM: the Secrets Manager bundle holding the
# keys below, plus the region to reach it in.
# SECRET_NAME=my-app/llm-keys
# AWS_REGION=ap-south-1

# S3 Storage Configuration
# In NORMAL mode, set AWS_ACCESS_KEY_ID & AWS_SECRET_ACCESS_KEY.
# In LAMBDA mode, boto3 relies on AWS IAM execution role automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_S3_BUCKET=my-s3-bucket



# ============================================
# Database Connectors (Connection URLs)
# ============================================

# Generic fallback database connection URL
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# SQLite3 (connection URL / path)
# SQLITE_URL=sqlite:///./data/app.db

# PostgreSQL (connection URL)
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/app_db

# MySQL (connection URL)
# MYSQL_URL=mysql://root:root@localhost:3306/app_db


# ============================================
# Gemini
# ============================================

# GEMINI_KEY       -> Gemini Developer API using GEMINI_KEY below
# SERVICE_ACC_JSON -> Vertex AI using a service-account JSON
GEMINI_KEY_TYPE=GEMINI_KEY

# Used when GEMINI_KEY_TYPE=GEMINI_KEY
GEMINI_KEY=

# Used when GEMINI_KEY_TYPE=SERVICE_ACC_JSON.
# Prefer the file path. The inline JSON variable exists for environments that
# cannot mount a file, and is the one that follows KEY_LOCATION.
# GEMINI_SERVICE_ACCOUNT_FILE=./secrets/gemini-sa.json
# GEMINI_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Vertex project falls back to GOOGLE_CLOUD_PROJECT, then to the project_id
# inside the service-account JSON. Location falls back to
# GOOGLE_CLOUD_LOCATION, then us-central1.
# GEMINI_PROJECT=your-gcp-project-id
# GEMINI_LOCATION=us-central1


# ============================================
# Other LLM Providers
# ============================================

OPEN_AI_KEY=
ANTHROPIC_KEY=
PERPLEXITY_KEY=

# Ollama (self-hosted; defaults to http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_KEY=

# vLLM (self-hosted; defaults to http://localhost:8000/v1)
# VLLM_URL=http://localhost:8000/v1
# VLLM_KEY=EMPTY
