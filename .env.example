# Copy to .env and fill in the values you need. .env is gitignored.

# --- OpenAI ---
OPEN_AI_KEY=

# --- Anthropic ---
ANTHROPIC_KEY=

# --- Perplexity ---
PERPLEXITY_KEY=

# --- Ollama (optional; defaults to http://localhost:11434) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_KEY=

# --- vLLM (optional; defaults to http://localhost:8000/v1) ---
# VLLM_URL=http://localhost:8000/v1
# VLLM_KEY=EMPTY

# --- Gemini auth ---
# Pick one: api_key (Gemini Developer API) or service_account (Vertex AI).
# Defaults to api_key when unset, so existing setups keep working.
GEMINI_AUTH_MODE=api_key

# Used when GEMINI_AUTH_MODE=api_key
GEMINI_KEY=

# Used when GEMINI_AUTH_MODE=service_account
# Prefer a file path. Inline JSON is supported for environments that cannot
# mount a file (escape newlines or collapse to a single line).
# GEMINI_SERVICE_ACCOUNT_FILE=./secrets/gemini-sa.json
# GEMINI_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Vertex AI project + location. Project falls back to GOOGLE_CLOUD_PROJECT,
# then to the project_id embedded in the service-account JSON. Location falls
# back to GOOGLE_CLOUD_LOCATION, then us-central1.
# GEMINI_PROJECT=your-gcp-project-id
# GEMINI_LOCATION=us-central1
